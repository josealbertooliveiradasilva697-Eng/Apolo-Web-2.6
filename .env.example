# Variáveis configuradas no servidor; este arquivo é apenas um exemplo.
# A aplicação não carrega .env automaticamente.
APOLO_AUTH_MODE=local
APOLO_LOCAL_ROLE=operador
# Papéis locais: operador, admin, desenvolvedor.
# APOLO_DATA_DIR=C:\caminho\apolo_web\data
# Modo online: configure ambas as opções juntas.
# APOLO_ENV=production
# APOLO_AUTH_MODE=supabase
# APOLO_REPOSITORY_MODE=supabase
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_exemplo
# Uma chave anon legada também é aceita. Nunca usar service_role/sb_secret.
# Valores não são carregados automaticamente deste arquivo.
